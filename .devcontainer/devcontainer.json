{
    "name": "Portfolio",
    "build": {
        "dockerfile": "Dockerfile"
    },

    "portsAttributes": {
        "4321": {
            "label": "Application",
            "onAutoForward": "openPreview"
        }
    },
    "forwardPorts": [
        4321
    ],
    "postCreateCommand": "npm ci && npm run build",
    "waitFor": "postCreateCommand",
    "postAttachCommand": {
        "Server": "npm run dev -- --host"
    },
    "customizations": {
        "codespaces": {
            "openFiles": [
                "src/pages/index.astro"
            ]
        },
        "vscode": {
            "extensions": [
                "astro-build.astro-vscode",
                "esbenp.prettier-vscode"
            ]
        }
    }
}