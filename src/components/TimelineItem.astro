---
interface Props {
	title: string;
	subtitle: string;
	points?: string[];
}
const { title, subtitle, points = [] } = Astro.props;
---

<div class="item" data-reveal>
	<div class="head">
		<h3>{title.toLowerCase()}</h3>
		<p class="label">{subtitle.toLowerCase()}</p>
	</div>
	{points.length > 0 && (
		<ul>
			{points.map((p) => (
				<li>{p}</li>
			))}
		</ul>
	)}
</div>

<style>
	.item {
		display: grid;
		gap: var(--space-md);
		padding-block: var(--space-lg);
		border-top: 1px solid var(--color-rule);
	}
	.item:first-child {
		border-top: 0;
		padding-top: 0;
	}
	.head {
		display: grid;
		gap: var(--space-2xs);
	}
	h3 {
		font-size: var(--text-xl);
	}
	ul {
		margin: 0;
		padding-left: var(--space-lg);
		display: grid;
		gap: var(--space-xs);
		line-height: 1.55;
	}
	ul li::marker {
		color: var(--color-accent);
	}
</style>
