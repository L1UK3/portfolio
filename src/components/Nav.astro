---
import { profile } from '../data/cv';
const links = [
	['projects', '#projects'],
	['skills', '#skills'],
	['education', '#education'],
	['work', '#work'],
];
---

<nav class="nav" aria-label="Sections">
	<div class="container bar">
		<a href="#top" class="mark">
			{profile.name.toLowerCase()}
		</a>
		<ul>
			{links.map(([l, h]) => (
				<li>
					<a class="link" href={h}>
						{l}
					</a>
				</li>
			))}
			<li>
				<a class="btn btn--secondary small" href={`mailto:${profile.email}`}>
					email me
				</a>
			</li>
		</ul>
	</div>
</nav>

<style>
	.nav {
		position: sticky;
		top: 0;
		z-index: var(--z-sticky-nav);
		background: color-mix(in oklab, var(--color-paper) 82%, transparent);
		backdrop-filter: blur(10px);
	}
	.bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		min-height: 72px;
		gap: var(--space-lg);
	}
	.mark {
		font: 500 var(--text-lg)/1 var(--font-display);
		letter-spacing: var(--tracking-display);
		text-decoration: none;
	}
	ul {
		display: flex;
		align-items: center;
		gap: var(--space-lg);
		list-style: none;
		margin: 0;
		padding: 0;
		font: 500 var(--text-sm)/1 var(--font-display);
	}
	.small {
		min-height: 40px;
	}
	@media (max-width: 40rem) {
		ul li:nth-child(-n + 4) {
			display: none;
		}
	}
</style>
