---
import { profile } from '../data/cv';
---

<section id="contact" class="contact">
	<div class="container">
		<h2 data-reveal>get in touch</h2>
		<p class="lead" data-reveal>
			Open to junior developer roles. Email is quickest.
		</p>
		<dl class="lines" data-reveal>
			<div>
				<dt class="label">email</dt>
				<dd>
					<a class="link" href={`mailto:${profile.email}`}>
						{profile.email}
					</a>
				</dd>
			</div>
			<div>
				<dt class="label">github</dt>
				<dd>
					<a class="link" href={profile.github.href} target="_blank" rel="noreferrer">
						{profile.github.label}
					</a>
				</dd>
			</div>
			<div>
				<dt class="label">where</dt>
				<dd>{profile.location}</dd>
			</div>
		</dl>
	</div>
</section>

<style>
	.contact {
		border-top: 1px solid var(--color-rule);
		padding-block: var(--section-gap-s);
	}
	.contact h2 {
		margin-bottom: var(--space-md);
		max-width: none;
		font-size: clamp(2.75rem, 9vw, 7rem);
		line-height: 0.95;
	}
	.lines {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
		gap: var(--space-lg) var(--gap-columns);
		margin: var(--space-xl) 0 0;
	}
	dt {
		margin-bottom: var(--space-2xs);
	}
	dd {
		margin: 0;
		font: 500 var(--text-xl)/1.3 var(--font-display);
		overflow-wrap: anywhere;
	}
	.colophon {
		border-top: 1px solid var(--color-rule);
		padding-block: var(--space-xl);
	}
	.colophon .label {
		max-width: 70ch;
	}
</style>
