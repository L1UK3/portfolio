---
import TagList from './TagList.astro';
import type { Project } from '../data/cv';
interface Props {
	project: Project;
	n: number;
}
const { project, n } = Astro.props;
---

<article class="card" data-reveal>
	<div class="top">
		<span class="mono num">{String(n).padStart(2, '0')}</span>
		<div>
			<h3>
				{project.href ? (
					<a href={project.href} target="_blank" rel="noreferrer">
						{project.title} <span aria-hidden="true">↗</span>
					</a>
				) : (
					project.title
				)}
			</h3>
			<p class="blurb">{project.blurb}</p>
		</div>
	</div>
	<ul class="points">
		{project.points.map((p) => (
			<li>{p}</li>
		))}
	</ul>
	<TagList tags={project.tags} />
</article>

<style>
	.card {
		position: relative;
		display: grid;
		gap: 1.25rem;
		padding: 1.75rem;
		border: 1px solid var(--line);
		border-radius: 14px;
		background: linear-gradient(180deg, var(--card), transparent);
		transition:
			border-color 0.3s,
			transform 0.3s;
	}
	.card:hover {
		border-color: color-mix(in srgb, var(--accent) 55%, var(--line));
		transform: translateY(-3px);
	}
	.top {
		display: flex;
		gap: 1.25rem;
	}
	.num {
		color: var(--accent);
		padding-top: 0.35rem;
	}
	h3 {
		margin: 0;
		font-size: 1.35rem;
		font-weight: 500;
		letter-spacing: -0.02em;
	}
	h3 a {
		color: inherit;
		text-decoration: none;
	}
	h3 a:hover {
		color: var(--accent);
	}
	.blurb {
		margin: 0.15rem 0 0;
		color: var(--muted);
	}
	.points {
		margin: 0;
		padding-left: 1.1rem;
		display: grid;
		gap: 0.5rem;
		color: var(--text-soft);
		line-height: 1.55;
		font-size: 0.93rem;
	}
	.points li::marker {
		color: var(--accent);
	}
</style>
