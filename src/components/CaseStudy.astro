---
import TagList from './TagList.astro';
import type { Project } from '../data/cv';
interface Props {
	project: Project;
}
const { project } = Astro.props;
---

<article class="case well" data-reveal>
	<h3>{project.title.toLowerCase()}</h3>
	<p class="blurb">{project.blurb}</p>
	<ul class="points">
		{project.points.map((p) => (
			<li>{p}</li>
		))}
	</ul>
	<div class="foot">
		<TagList tags={project.tags} />
		{project.href && (
			<a class="btn btn--primary" href={project.href} target="_blank" rel="noreferrer">
				visit {project.title}
			</a>
		)}
	</div>
</article>

<style>
	.case {
		display: grid;
		gap: var(--space-lg);
		padding: var(--space-xl);
	}
	h3 {
		font-size: var(--text-3xl);
	}
	.blurb {
		color: var(--color-muted);
	}
	.points {
		margin: 0;
		padding-left: var(--space-lg);
		display: grid;
		gap: var(--space-sm);
		line-height: 1.55;
	}
	.points li::marker {
		color: var(--color-accent);
	}
	.foot {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-md);
	}
	@media (max-width: 40rem) {
		.case {
			padding: var(--space-lg);
		}
	}
</style>
