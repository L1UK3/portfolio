---
import TagList from './TagList.astro';
interface Props {
	label: string;
	items: string[];
}
const { label, items } = Astro.props;
---

<div class="row" data-reveal>
	<h3 class="label">{label.toLowerCase()}</h3>
	<TagList tags={items} />
</div>

<style>
	.row {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
		gap: var(--gap-columns);
		padding-block: var(--space-lg);
		border-top: 1px solid var(--color-rule);
		align-items: start;
	}
	.row:first-child {
		border-top: 0;
		padding-top: 0;
	}
	.label {
		font: 500 var(--text-sm)/1.3 var(--font-display);
		letter-spacing: 0;
		color: var(--color-muted);
		max-width: none;
	}
	@media (max-width: 40rem) {
		.row {
			grid-template-columns: minmax(0, 1fr);
			gap: var(--space-sm);
		}
	}
</style>
