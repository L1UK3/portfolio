---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Section from "../components/Section.astro";
import ProjectCard from "../components/ProjectCard.astro";
import SkillGroup from "../components/SkillGroup.astro";
import TimelineItem from "../components/TimelineItem.astro";
import { projects, skills, education, employment } from "../data/cv";
---

<Layout title="Luke Enness — Developer">
    <Nav />
    <Hero />

    <Section id="projects" index="01" title="Projects">
        <div class="stack">
            {projects.map((p, i) => <ProjectCard project={p} n={i + 1} />)}
        </div>
    </Section>

    <Section id="skills" index="02" title="Technical skills">
        <div class="grid">
            {skills.map((s) => <SkillGroup label={s.label} items={s.items} />)}
        </div>
    </Section>

    <Section id="education" index="03" title="Education">
        {education.map((e) => <TimelineItem title={e.title} subtitle={e.subtitle} />)}
    </Section>

    <Section id="work" index="04" title="Current employment">
        {employment.map((e) => <TimelineItem title={e.title} subtitle={e.subtitle} points={e.points} />)}
    </Section>
</Layout>

<style>
    .stack { display: grid; gap: 1.25rem; }
    .grid { align-items: start; display: grid; gap: 2rem 2.5rem; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); }
</style>
