---
import '../styles/global.css';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import ProjectRow from '../components/ProjectRow.astro';
import Colophon from '../components/Colophon.astro';
import { projects } from '../data/cv';
---

<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content="Luke Enness, junior developer in Swansea, UK." />
		<title>Luke Enness, junior developer</title>
	</head>
	<body>
		<main class="page">
			<Hero />

			<Section id="projects" title="projects I’ve built">
				<div class="index">
					{projects.map((p) => (
						<ProjectRow project={p} />
					))}
				</div>
			</Section>

			<Colophon />
		</main>
	</body>
</html>

<style>
	.page {
		position: relative;
		z-index: var(--z-base);
	}
	.index {
		margin-top: var(--space-xl);
		border-bottom: 1px solid var(--color-rule);
	}
</style>
