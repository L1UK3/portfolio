---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import CaseStudy from '../components/CaseStudy.astro';
import ProjectRow from '../components/ProjectRow.astro';
import SkillGroup from '../components/SkillGroup.astro';
import TimelineItem from '../components/TimelineItem.astro';
import Colophon from '../components/Colophon.astro';
import { projects, skills, education, employment } from '../data/cv';
const [featured, ...others] = projects;
---

<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content="Luke Enness, junior developer in Swansea, UK." />
		<title>Luke Enness, junior developer</title>
	</head>
	<body>
		<main class="page">
			<Nav />
			<Hero />

			<Section id="skills" title="technical skills">
				{skills.map((s) => (
					<SkillGroup label={s.label} items={s.items} />
				))}
			</Section>

			<Section id="projects" title="projects I’ve built">
				<CaseStudy project={featured} />
				<div class="index">
					{others.map((p) => (
						<ProjectRow project={p} />
					))}
				</div>
			</Section>

			<Section id="education" title="education">
				{education.map((e) => (
					<TimelineItem title={e.title} subtitle={e.subtitle} />
				))}
			</Section>

			<Section id="work" title="current employment">
				{employment.map((e) => (
					<TimelineItem title={e.title} subtitle={e.subtitle} points={e.points} />
				))}
			</Section>

			<Colophon />
		</main>
	</body>
</html>

<style>
	.page {
		position: relative;
		z-index: var(--z-base);
	}
	.index {
		margin-top: var(--space-xl);
		border-bottom: 1px solid var(--color-rule);
	}
</style>
